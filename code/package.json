{
  "name": "airdrop-azure-entra-id",
  "version": "1.0.0",
  "description": "DevRev AirSync connector for Azure Entra ID",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "build:watch": "tsc --watch",
    "prepackage": "npm run build",
    "package": "tar -cvzf build.tar.gz dist package.json package-lock.json .npmrc",
    "start": "ts-node ./src/main.ts",
    "start:watch": "nodemon ./src/main.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:server": "nodemon --watch src --watch test test/main.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "@devrev/ts-adaas": "^1.18.0",
    "@devrev/typescript-sdk": "^1.0.0",
    "axios": "^1.16.0"
  },
  "overrides": {
    "protobufjs": ">=7.6.3",
    "axios": "^1.16.0",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@types/body-parser": "^1.19.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "babel-jest": "^29.7.0",
    "body-parser": "^1.20.3",
    "dotenv": "^16.4.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-security": "^3.0.1",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0",
    "yargs": "^17.7.2"
  }
}
